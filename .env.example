# Arquivo .env.example (PODE ir para o GitHub) — apenas placeholders.
# Copie para ".env" e preencha com valores reais. O .env NUNCA vai pro git.

# ===== Flask =====
SECRET_KEY=coloque_uma_chave_secreta_bem_grande_aqui

# ===== E-mail (Flask-Mail) =====
MAIL_SERVER=smtp.gmail.com
MAIL_USERNAME=seu_email@gmail.com
MAIL_PASSWORD=sua_senha_de_app_aqui

# ===== PostgreSQL (credenciais usadas pelos containers) =====
POSTGRES_USER=gcs_user
POSTGRES_PASSWORD=troque_esta_senha

# ===== Conexão usada pela APP/TESTES quando rodando FORA do Docker =====
# Homolog expõe o banco na porta 5433; o Postgres de teste, na 5435.
DATABASE_URL=postgresql://gcs_user:troque_esta_senha@localhost:5433/gcs_homolog
TEST_DATABASE_URL=postgresql://gcs_user:gcs_pass@localhost:5435/gcs_test
